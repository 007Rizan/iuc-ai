# Bu dosyayı .env.local adıyla kopyalayıp değerleri doldurun. .env.local asla commit edilmez.

# Google AI Studio → Get API key
GEMINI_API_KEY=

# Supabase → Project Settings → Data API (Project URL, sonunda /rest/v1 OLMADAN)
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Publishable anahtar DEĞİL.
SUPABASE_SECRET_KEY=
